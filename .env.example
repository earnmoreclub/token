# Copy to .env.local for local dev; set the same keys in Vercel Project Settings → Environment Variables.

# Public site URL used for Stripe success/cancel redirects (falls back to VERCEL_URL).
NEXT_PUBLIC_SITE_URL=https://store.domain.com
# OpenAI-compatible base URL shown to customers.
NEXT_PUBLIC_GATEWAY_BASE_URL=https://gateway.domain.com/v1

# Stripe (server-only)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase (server-only; service role bypasses RLS, never expose to the client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstream OneAPI / NewAPI admin (server-only)
UPSTREAM_URL=https://gateway.domain.com
UPSTREAM_ADMIN_TOKEN=your-admin-access-token
# Required by NewAPI (sent as New-Api-User header); leave empty for OneAPI.
UPSTREAM_ADMIN_USER_ID=1

# Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM="TokenGate <keys@domain.com>"
